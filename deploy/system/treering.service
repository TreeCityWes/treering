# Hardened system service: the bot runs as its own unprivileged user. See deploy/system/README.md.
[Unit]
Description=Treering - Mood Ring signal bot for Hyperliquid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=treering
Group=treering
WorkingDirectory=/opt/treering
Environment=TREERING_DATA_DIR=/var/lib/treering TREERING_CONFIG_FILE=/etc/treering/config.json TREERING_SHARED_GROUP=1
# Secrets are read by systemd as root and handed to the process; the files are root-only (0600).
EnvironmentFile=/etc/treering/agent.env
EnvironmentFile=-/etc/treering/alerts.env
ExecStart=/usr/bin/node /opt/treering/src/bot.js
Restart=always
RestartSec=15
UMask=0007
ReadWritePaths=/var/lib/treering
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
